{
  "name": "engaging-networks-regive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build && npm exec terser -- -c -m --module dist/regive.js > dist/regive.min.js",
    "watch": "vite build --watch",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "npm run build && playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "npm run build && playwright test --config tests/playwright.config.ts --ui",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "browserslist-to-esbuild": "^2.1.1",
    "jsdom": "^26.1.0",
    "sass-embedded": "^1.86.3",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.2.4"
  }
}
